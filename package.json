{
  "name": "fossesnotes-quantum-v3",
  "version": "3.0.0",
  "description": "Application SaaS révolutionnaire de pêche à la mouche Canada Atlantique - 18 rivières authentiques",
  "main": "server/index.js",
  "scripts": {
    "predev": "npx kill-port 3000 5000 || exit 0",
    "dev": "concurrently -k -n \"api,web\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm:server\" \"npm:web\"",
    "server": "nodemon server/index.js",
    "web": "cd web && npx next dev -p 3000",

    "dev:legacy": "concurrently -k -n \"api,web,legacy\" -c \"bgBlue.bold,bgMagenta.bold,bgYellow.bold\" \"npm:server\" \"npm:web\" \"npm:client-legacy\"",
    "client-legacy": "cd client && set PORT=3100&& npm start",

    "build": "cd web && npx next build",
    "start": "node server/index.js",

    "start:test": "NODE_ENV=test node server/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:community": "playwright test community.test.js",
    "test:e2e:data-collection": "playwright test data-collection.test.js",
    "seed:gamification": "node server/scripts/seedGamification.js",
    "migrate:community": "node scripts/apply-community-migration.js",
    "setup:community": "node scripts/setup-community.js",
    "migrate:data-collection": "node scripts/apply-data-collection-migration.js",
    "setup:data-collection": "node scripts/setup-data-collection.js",
    "clean:obsolete": "node scripts/move-obsolete.js",
    "clean:obsolete:list": "node scripts/move-obsolete.js list",
    "clean:obsolete:restore": "node scripts/move-obsolete.js restore",
    "test:init-db": "node scripts/init-test-db.js",
    "test:setup": "npm run test:init-db && npm run test",
    "import:rivers": "node scripts/import-rivers-master.js",
    "rivers:normalize": "node scripts/normalize-rivers.js",
    "rivers:apply-patch": "node scripts/apply-master-patch.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "paypal-rest-sdk": "^1.8.1",
    "pdfkit": "^0.17.1",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sequelize": "^6.37.7",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pêche",
    "mouche",
    "canada",
    "atlantique",
    "rivières",
    "saumon",
    "truite",
    "gps",
    "carte",
    "communauté",
    "fishing",
    "fly-fishing",
    "react",
    "nodejs",
    "saas"
  ],
  "author": "FossesNotes Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/fossesnotes-quantum.git"
  },
  "homepage": "https://github.com/username/fossesnotes-quantum#readme",
  "bugs": {
    "url": "https://github.com/username/fossesnotes-quantum/issues"
  }
}
