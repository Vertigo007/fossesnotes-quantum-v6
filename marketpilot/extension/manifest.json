{
  "manifest_version": 3,
  "name": "MarketPilot — Assistant Marketplace",
  "short_name": "MarketPilot",
  "version": "0.1.0",
  "description": "Crée tes annonces Facebook Marketplace avec l'IA : photos depuis ton cell, prix du marché, rédaction, relances et baisses de prix approuvées.",
  "default_locale": "fr",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Ouvrir MarketPilot" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["https://www.facebook.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["content/fb-dom.js", "content/fb-search.js", "content/fb-form.js", "content/fb-selling.js"],
      "run_at": "document_idle"
    }
  ]
}
