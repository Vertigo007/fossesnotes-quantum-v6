# Copie ce fichier en .env puis remplis les valeurs.

# Jeton partagé serveur / extension / cellulaire (16+ caractères). Ex.: openssl rand -hex 24
MARKETPILOT_TOKEN=

# Clé API Anthropic (https://platform.claude.com) — analyse photos, rédaction, comparaison, réponses.
ANTHROPIC_API_KEY=

# Adresse que ton cellulaire peut joindre (IP locale de ton ordi, ou URL publique ngrok/Render).
PUBLIC_URL=http://192.168.1.20:8787
PORT=8787

# Fuseau pour les heures de pointe Marketplace (soirs de semaine, matins de fin de semaine).
TZ=America/Toronto

# Notifications push sur ton cell via l'app ntfy (choisis un sujet long et impossible à deviner).
NTFY_TOPIC=

# Optionnel
# MARKETPILOT_MODEL=claude-opus-5-5
# SCHEDULER_INTERVAL_MIN=30
# DATA_DIR=./data
