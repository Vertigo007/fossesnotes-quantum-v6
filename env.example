# Configuration de l'environnement
NODE_ENV=development

# Base de données PostgreSQL
DATABASE_URL=postgresql://fossesnotes:password@localhost:5432/fossesnotes

# Cache Redis
REDIS_URL=redis://localhost:6379

# JWT Secret (CHANGEZ EN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id

# URLs Frontend
FRONTEND_URL=http://localhost:3000

# APIs externes (Open Source)
# Open-Meteo: 100% gratuit, sans clé API requise
# OpenWeatherMap: Alternative gratuite (optionnel)
OPENWEATHER_API_KEY=your_openweather_api_key_optional

# Cartes Open Source (remplace Mapbox)
# OpenStreetMap, OpenTopoMap, CartoDB, Stamen - tous gratuits

# Monitoring
SENTRY_DSN=your_sentry_dsn

# Ports
PORT=5000
CLIENT_PORT=3000 